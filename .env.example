# Copie para .env e preencha. O .env nunca é versionado.

# Senha do Neo4j. Obrigatória — o compose recusa subir sem ela.
NEO4J_PASSWORD=

# Conexão usada pelo backend.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j

# Origens permitidas pelo CORS, separadas por vírgula.
# Em produção, liste o domínio do demo; nunca use "*".
# 5173/5179: Vite em dev fora de container. 8080: FRONTEND_PORT abaixo, o
# nginx do container "frontend" no docker-compose.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Portas publicadas em loopback pelo docker-compose (serviços backend/frontend).
# Mude aqui se 8000/8080 já estiverem ocupadas no host.
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Chave da API do NCBI (opcional; eleva o limite de 3 para 10 req/s).
NCBI_API_KEY=

# E-mail exigido pelo Entrez em toda consulta ao NCBI.
NCBI_EMAIL=
