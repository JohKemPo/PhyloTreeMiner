# Endereço do backend em desenvolvimento local (F-2).
# `vite dev` carrega este arquivo automaticamente (modo "development").
# Para apontar para outro backend, copie para `.env.development.local`
# (ignorado pelo git) e sobrescreva os valores abaixo.
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
