# Endereço do backend usado por `vite build` (produção — inclui o build
# dentro do container em Frontend/Dockerfile). Mesma topologia de hoje:
# backend publicado em 127.0.0.1:8000 no host (ver docker-compose.yml) e o
# frontend chamando essa porta direto — ver nginx.conf, comentário sobre
# F-2/Arq-C. Ajuste aqui quando o proxy /api do nginx passar a ser usado.
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
